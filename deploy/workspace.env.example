# Environment of the workspace container (deploy/compose.yaml → env_file). Copy to
# deploy/workspace.env (chmod 600); every variable is documented in the repository's .env.example.

# Stalwart (OIDC): the client you create in Stalwart's admin, redirect URI
# https://team.example.com/api/auth/callback.
OIDC_ISSUER=https://mail.example.com
OIDC_CLIENT_ID=zentico-workspace
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
APP_URL=https://team.example.com
# openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Meet (LiveKit): the same key/secret as livekit.yaml and egress.yaml.
LIVEKIT_URL=wss://meet.example.com
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET
EGRESS_ENABLED=true

DATA_DIR=/app/data
# Comma-separated workspace accounts with admin rights in the app.
WORKSPACE_ADMINS=admin@example.com

# Optional: Docs (profile "office"). Leave empty without Collabora.
COLLABORA_URL=
# Optional: transcripts (profile "whisper"). Leave empty without Whisper.
WHISPER_URL=
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_LANGUAGE=
