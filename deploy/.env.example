# Compose settings for deploy/compose.yaml. Copy to deploy/.env (chmod 600); never commit it.
# install.sh writes this file for you and keeps existing values on re-runs.

# Base domain: the app is team.<DOMAIN>, Stalwart mail.<DOMAIN>, LiveKit meet.<DOMAIN>,
# Collabora office.<DOMAIN>. Mail addresses are @<DOMAIN>.
DOMAIN=example.com
# Let's Encrypt account e-mail (Caddy).
ACME_EMAIL=admin@example.com

# Stalwart web admin login, "admin:<password>" (password: openssl rand -hex 16).
STALWART_RECOVERY_ADMIN=admin:CHANGE_ME_STALWART_ADMIN_PASSWORD

# Optional services to run: office (Collabora), whisper (transcripts), comma separated.
COMPOSE_PROFILES=
# CPU threads for the Whisper server.
WHISPER_CPU_THREADS=4

# Generated secrets that install.sh renders into workspace.env, livekit.yaml and egress.yaml.
# (When configuring by hand, put the same values directly in those files instead.)
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
