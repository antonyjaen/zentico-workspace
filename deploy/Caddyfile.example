# Copy to deploy/Caddyfile and replace example.com with your domain. Caddy runs on the host network
# and gets Let's Encrypt certificates for each site automatically (ports 80 and 443 must be open).
{
	email admin@example.com
}

team.example.com {
	reverse_proxy localhost:3100
}

mail.example.com {
	reverse_proxy localhost:8081
}

meet.example.com {
	reverse_proxy localhost:7880
}

# BEGIN office (Collabora, profile "office"; remove this block without it)
office.example.com {
	reverse_proxy localhost:9980
}
# END office
