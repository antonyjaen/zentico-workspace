# OpenID Connect provider (Stalwart) — the same login as the user's email
OIDC_ISSUER=https://mail.zentico.dev
OIDC_CLIENT_ID=zentico-workspace
OIDC_CLIENT_SECRET=
# Public URL of this app (used to build the OAuth redirect URI)
APP_URL=http://localhost:3000
# Random string (>= 32 chars) used to encrypt the session cookie
SESSION_SECRET=
# Collabora Online server for Docs (WOPI). Leave empty to show "not configured" in Docs.
COLLABORA_URL=
# Optional: public base Collabora uses to reach /api/wopi (defaults to APP_URL). Use it when
# Collabora only allows another WOPI host, e.g. https://cloud.zentico.dev/zw-wopi proxied here.
WOPI_BASE_URL=
# LiveKit server for Meet. Leave empty to show "Meet isn't configured yet".
# URL is the public WebSocket endpoint browsers connect to (wss:// in production).
LIVEKIT_URL=
# API key/secret pair from the LiveKit server config (`keys:` in livekit.yaml); secret >= 32 chars
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Chat storage (Node's built-in SQLite, WAL mode). Must be on a persistent volume in production;
# the directory is created on first use. Relative paths resolve from the app's working directory.
CHAT_DB_PATH=./data/chat.sqlite
# Chat attachments (max 25 MB each), served only to members of the conversation. Persistent volume too.
CHAT_FILES_DIR=./data/chat-files
# Persistent data directory for Meet recordings: metadata in DATA_DIR/meetings.sqlite and audio in
# DATA_DIR/meetings/<id>/ (max 200 MB per meeting). Mount it on a persistent volume (default ./data).
DATA_DIR=./data
# Self-hosted Whisper server with an OpenAI-compatible API (e.g. speaches/faster-whisper-server),
# reached from this container: POST {WHISPER_URL}/v1/audio/transcriptions. Leave empty to keep
# recording audio but show "Transcription not configured" (retry from the recording page later).
WHISPER_URL=
# Model name passed to the Whisper server.
WHISPER_MODEL=Systran/faster-whisper-small
# Optional ISO-639-1 language hint (e.g. es, en). Empty = auto-detect per speaker segment.
WHISPER_LANGUAGE=
# Connected apps (Settings → Apps & bots → Connected apps): OAuth client credentials per provider.
# A provider without both values is shown as "Not configured". Register each OAuth app with the
# redirect/callback URL ${APP_URL}/api/connect/<provider>/callback (github, google, atlassian, notion, slack).
CONNECT_GITHUB_CLIENT_ID=
CONNECT_GITHUB_CLIENT_SECRET=
CONNECT_GOOGLE_CLIENT_ID=
CONNECT_GOOGLE_CLIENT_SECRET=
CONNECT_ATLASSIAN_CLIENT_ID=
CONNECT_ATLASSIAN_CLIENT_SECRET=
CONNECT_NOTION_CLIENT_ID=
CONNECT_NOTION_CLIENT_SECRET=
CONNECT_SLACK_CLIENT_ID=
CONNECT_SLACK_CLIENT_SECRET=
