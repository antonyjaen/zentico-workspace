# Dependencies and build output
node_modules/
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Environment and secrets: only the documented placeholder file is committed
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.npmrc

# Runtime data: SQLite stores, chat files, recordings, downloads (DATA_DIR, CHAT_DB_PATH, CHAT_FILES_DIR)
data/
*.sqlite
*.sqlite-*
*.db
*.db-*

# Operational output captured from scripts run against a real server (contains real accounts)
scripts/*.plan.json

# Self-hosting (deploy/): files rendered from the *.example templates and runtime data
deploy/Caddyfile
deploy/livekit.yaml
deploy/egress.yaml
deploy/caddy/
deploy/stalwart/

# Logs, scratch and temp files
*.log
logs/
tmp/
temp/
scratch/
*.tmp

# Desktop app (Tauri) build outputs and generated ACL files
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/permissions/autogenerated/

# Mobile app (Capacitor): build output, local SDK paths and signing material never go in git
apps/mobile/android/keystore.properties
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/android/local.properties
google-services.json
GoogleService-Info.plist
apps/mobile/ios/App/Pods/
apps/mobile/ios/App/build/
*.apk
*.aab
*.ipa

# Native installers (served from DATA_DIR/downloads, uploaded at release time)
*.exe
*.msi
*.dmg

# Launch videos (generated)
brag-output*/

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Claude Code: personal settings stay local (shared project settings/skills may be committed)
.claude/settings.local.json
.claude/*.local.*
